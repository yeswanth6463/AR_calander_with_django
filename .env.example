# Copy to .env and adjust before deploying.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Comma-separated, no spaces. Include the public origin(s).
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Database
POSTGRES_DB=ar_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Gunicorn
GUNICORN_WORKERS=3

# Published HTTP port on the host (put a TLS terminator / certbot in front for HTTPS)
HTTP_PORT=80
